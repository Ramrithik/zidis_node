mach create "ZIDIS_Node"
machine LoadPlatformDescriptionFromString "cpu: CPU.CortexM @ sysbus { cpuType: `"cortex-m33`" }"
machine LoadPlatformDescriptionFromString "flash: Memory.MappedMemory @ sysbus 0x08000000 { size: 0x80000 }"
machine LoadPlatformDescriptionFromString "sram: Memory.MappedMemory @ sysbus 0x20000000 { size: 0x40000 }"
sysbus LoadELF @ZIDIS_Node.elf
start
